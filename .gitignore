# ==========================================
# Python Standard Ignores
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# SSI Project-Specific Generated Files
# ==========================================
# Ignore large generated CSV datasets
SSI_Steel_Frame_ML_Dataset_*.csv
*.csv

# Ignore generated log files and text reports
analysis_errors.log
statistical_summary_report.txt
*.log

# Ignore all auto-generated Matplotlib PNG plots
Analysis_*.png
Sample_ModeShape_*.png
Sample_Comparison_Mode_*.png
